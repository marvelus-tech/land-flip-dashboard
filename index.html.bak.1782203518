            {id:54,name:'CRAFTED Custom Homes + Renovations',county:'Harris/Galveston',state:'texas',metro:'Friendswood/Houston',phone:'(281) 648-3500',email:'',website:'https://craftedhome.com',buyBox:'Custom + renovation',volume:'GHBA Pro Builder + Remodeler',status:'research',dateAdded:'2026-06-22',initials:'CC'},
            {id:55,name:'Alair Homes Houston',county:'Harris County',state:'texas',metro:'Bellaire/Houston',phone:'(713) 664-7272',email:'',website:'https://www.alairhomes.com/houston223',buyBox:'Custom homes',volume:'Franchise custom builder',status:'research',dateAdded:'2026-06-22',initials:'AH'},
            {id:56,name:'Sandcastle Homes, Inc.',county:'Harris County',state:'texas',metro:'Houston',phone:'(713) 851-2767',email:'',website:'',buyBox:'Custom homes',volume:'GHBA Distinguished Member',status:'research',dateAdded:'2026-06-22',initials:'SH'},
            {id:57,name:'Divine Renovation',county:'Harris County',state:'texas',metro:'Houston',phone:'(713) 515-1514',email:'',website:'',buyBox:'Custom + renovation',volume:'GHBA Distinguished Member',status:'research',dateAdded:'2026-06-22',initials:'DR'},
            {id:58,name:'Centex Homes - Stokesbury',county:'Waller County',state:'texas',metro:'Waller/Houston',phone:'(936) 296-3200',email:'',website:'https://www.centex.com',buyBox:'New home communities',volume:'National production builder',status:'research',dateAdded:'2026-06-22',initials:'CX'},
            {id:59,name:'K. Hovnanian Homes Lakeview',county:'Waller County',state:'texas',metro:'Waller/Houston',phone:'(888) 425-1559',email:'',website:'https://www.khov.com',buyBox:'New home communities',volume:'66 yrs national builder',status:'research',dateAdded:'2026-06-22',initials:'KH'},
            {id:60,name:'D.R. Horton - Houston',county:'Fort Bend/Montgomery/Waller',state:'texas',metro:'Greater Houston',phone:'(800) 374-6142',email:'',website:'https://www.drhorton.com',buyBox:'Move-in ready / communities',volume:'Largest US homebuilder',status:'research',dateAdded:'2026-06-22',initials:'DH'}
        ];

        let currentFilter = 'all';
        let currentSearch = '';
        let currentTab = 'builders';

        function updateMetrics() {
            const active = builders.filter(b => b.status === 'active').length;
            const research = builders.filter(b => b.status === 'research').length;
            document.getElementById('total').textContent = builders.length;
            document.getElementById('active').textContent = active;
            document.getElementById('research').textContent = research;
            document.getElementById('states').textContent = '2';
        }

        function createStateFilters() {
            const container = document.getElementById('state-filters');
            container.innerHTML = `
                <div onclick="filterByState('all')" class="state-pill active" id="pill-all">All States</div>
                <div onclick="filterByState('tennessee')" class="state-pill" id="pill-tennessee">Tennessee</div>
                <div onclick="filterByState('texas')" class="state-pill" id="pill-texas">Texas</div>
            `;
        }

        function filterByState(state) {
            currentFilter = state;
            document.querySelectorAll('.state-pill').forEach(p => p.classList.remove('active'));
            document.getElementById('pill-' + state).classList.add('active');
            filterAndRender();
        }

        function filterAndRender() {
            const term = document.getElementById('search').value.toLowerCase().trim();
            currentSearch = term;

            let filtered = builders;

            if (currentFilter !== 'all') {
                filtered = filtered.filter(b => b.state === currentFilter);
            }
            if (term) {
                filtered = filtered.filter(b =>
                    b.name.toLowerCase().includes(term) ||
                    b.county.toLowerCase().includes(term) ||
                    b.metro.toLowerCase().includes(term)
                );
            }

            renderGrouped(filtered);
        }

        function renderGrouped(filteredBuilders) {
            const tnContainer = document.getElementById('tennessee-section');
            const txContainer = document.getElementById('texas-section');

            const tn = filteredBuilders.filter(b => b.state === 'tennessee');
            const tx = filteredBuilders.filter(b => b.state === 'texas');

            tnContainer.innerHTML = tn.length ? `
                <div class="section-header">Tennessee — ${tn.length} builders</div>
                ${tn.map(renderBuilderRow).join('')}
            ` : '';

            txContainer.innerHTML = tx.length ? `
                <div class="section-header" style="margin-top:32px;">Texas — ${tx.length} builders</div>
                ${tx.map(renderBuilderRow).join('')}
            ` : '';
        }

        function renderBuilderRow(b) {
            const statusClass = b.status === 'active' ? 'active' : 'research';
            const statusLabel = b.status === 'active' ? 'Active' : 'Research';

            const actions = `
                <div class="actions">
                    ${b.email ? `<a href="mailto:${b.email}" class="action-btn" title="Email"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M22 6l-10 7L2 6"/></svg></a>` : ''}
                    ${b.phone ? `<a href="tel:${b.phone}" class="action-btn" title="Call"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg></a>` : ''}
                    ${b.website ? `<a href="${b.website}" target="_blank" class="action-btn" title="Website"><svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><path d="M15 3h6v6"/><path d="M10 14L21 3"/></svg></a>` : ''}
                </div>
            `;

            return `
                <div class="builder-row">
                    <div class="builder-main">
                        <div class="builder-name">${b.name}</div>
                        <div class="builder-location">${b.county} • ${b.metro}</div>
                    </div>
                    
                    <div class="status ${statusClass}">
                        <div class="status-dot"></div>
                        <span>${statusLabel}</span>
                    </div>

                    ${actions}
                </div>
            `;
        }

        function switchTab(tab) {
            currentTab = tab;
            document.getElementById('tab-builders').classList.toggle('active', tab === 'builders');
            document.getElementById('tab-lots').classList.toggle('active', tab === 'lots');

            document.getElementById('builder-section').style.display = tab === 'builders' ? 'block' : 'none';
            document.getElementById('lots-section').style.display = tab === 'lots' ? 'block' : 'none';
            document.getElementById('state-filters').style.display = tab === 'builders' ? 'flex' : 'none';
        }

        function exportCSV() {
            const headers = ['Name','County','State','Metro','Status','Phone','Email','Website'];
            const rows = builders.map(b => [
                `"${b.name}"`, `"${b.county}"`, b.state, `"${b.metro}"`, b.status,
                `"${b.phone || ''}"`, `"${b.email || ''}"`, `"${b.website || ''}"`
            ]);
            
            let csv = headers.join(',') + '\n' + rows.map(r => r.join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'land-flip-builders.csv';
            a.click();
            URL.revokeObjectURL(url);
        }

        function init() {
            updateMetrics();
            createStateFilters();
            renderGrouped(builders);
            
            // Subtle image treatment on header (already done via CSS)
            // Keyboard support
            document.getElementById('search').addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    this.value = '';
                    filterAndRender();
                }
            });
            
            // Default to all states
            console.log('%c[Land & Light] Premium redesign initialized', 'color:#8E8E93');
        }

        window.onload = init;
    </script>
</body>
</html>